# Copy to .env, then run: php bin/keygen.php
APP_NAME=Haven
APP_ENV=local
# true shows exception details on the 500 page. Keep false for demos.
APP_DEBUG=false
# true shows the demo-account box on the sign-in page.
APP_DEMO=true
# AES-256-GCM key for report content. Generated by bin/keygen.php. Changing it makes existing reports unreadable.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=haven_v2
DB_USER=root
DB_PASS=

SESSION_IDLE_MINUTES=30

# Batas waktu balasan (Reply_SLA) dalam jam: kasus bahaya dan kasus lainnya.
# Harus bilangan bulat positif. Nilai kosong atau tidak sah memakai 2 dan 48.
SLA_DANGER_HOURS=2
SLA_DEFAULT_HOURS=48

# SMTP. Host atau port kosong berarti email tidak dikirim: isinya ditulis ke
# storage/mail.log dan tidak ada koneksi SMTP yang dibuka.
# MAIL_ENCRYPTION: tls (STARTTLS, umumnya port 587), ssl (TLS implisit, port 465),
# atau kosong untuk penangkap email lokal tanpa enkripsi.
# MAIL_USER kosong berarti server tidak meminta AUTH LOGIN.
# Email yang gagal dikirim masuk tabel mail_queue dan dicoba ulang oleh
# bin/mail-queue.php (5 kali, jeda 10 menit) — jadwalkan tiap 5 sampai 10 menit.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
# Alamat pengirim. Kosong berarti memakai MAIL_USER.
MAIL_FROM=
# Nama pengirim di kotak masuk. Kosong berarti memakai APP_NAME.
MAIL_FROM_NAME=
